{
    "name": "github-trending",
    "displayName": "%extension.displayName%",
    "version": "0.3.1",
    "description": "%extension.description%",
    "categories": [
        "Other"
    ],
    "keywords": [
        "github",
        "github trending",
        "github-trending",
        "trending"
    ],
    "homepage": "https://github.com/TaipaXu/github-trending-vscode",
    "bugs": "https://github.com/TaipaXu/github-trending-vscode/issues",
    "license": "GPL-3.0",
    "author": {
        "name": "Taipa Xu",
        "url": "https://github.com/TaipaXu"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/TaipaXu/github-trending-vscode"
    },
    "publisher": "TaipaXu",
    "main": "./out/extension.js",
    "scripts": {
        "dev": "vp build --watch --mode development",
        "build": "vp build",
        "type-check": "tsc --noEmit",
        "lint": "vp lint . --fix",
        "format": "vp fmt .",
        "check": "vp check .",
        "package": "vp run build && vp exec vsce package --no-dependencies",
        "prepare": "vp config"
    },
    "dependencies": {
        "cheerio": "1.2.0",
        "marked": "^18.0.5"
    },
    "devDependencies": {
        "@types/node": "20.17.0",
        "@types/vscode": "1.98.0",
        "@vscode/vsce": "^3.9.2",
        "typescript": "^6.0.3",
        "vite-plus": "^0.2.1"
    },
    "l10n": "./l10n",
    "contributes": {
        "commands": [
            {
                "command": "github-trending.dailyRefresh",
                "title": "%command.dailyRefresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "github-trending.weeklyRefresh",
                "title": "%command.weeklyRefresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "github-trending.monthlyRefresh",
                "title": "%command.monthlyRefresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "github-trending.openInBrowser",
                "title": "%command.openInBrowser.title%",
                "icon": "$(globe)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "githubTrending",
                    "title": "%extension.displayName%",
                    "icon": "static/images/icon.svg"
                }
            ]
        },
        "views": {
            "githubTrending": [
                {
                    "id": "trendingDaily",
                    "name": "%view.daily.name%",
                    "icon": "static/images/daily.svg"
                },
                {
                    "id": "trendingWeekly",
                    "name": "%view.weekly.name%",
                    "icon": "static/images/weekly.svg",
                    "visibility": "collapsed"
                },
                {
                    "id": "trendingMonthly",
                    "name": "%view.monthly.name%",
                    "icon": "static/images/monthly.svg",
                    "visibility": "collapsed"
                }
            ]
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "github-trending.openInBrowser",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "github-trending.dailyRefresh",
                    "when": "view == trendingDaily",
                    "group": "navigation@0"
                },
                {
                    "command": "github-trending.weeklyRefresh",
                    "when": "view == trendingWeekly",
                    "group": "navigation@0"
                },
                {
                    "command": "github-trending.monthlyRefresh",
                    "when": "view == trendingMonthly",
                    "group": "navigation@0"
                }
            ],
            "view/item/context": [
                {
                    "command": "github-trending.openInBrowser",
                    "when": "view == trendingDaily || view == trendingWeekly || view == trendingMonthly",
                    "title": "%command.openInBrowser.title%",
                    "group": "inline"
                }
            ]
        }
    },
    "icon": "static/images/icon.png",
    "engines": {
        "node": "24.17.0",
        "vscode": "^1.98.0"
    },
    "packageManager": "pnpm@11.5.2"
}
